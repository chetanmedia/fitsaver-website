  </section>

  <!-- ============================================================ CHAPTER: PROGRESS (the phone flies in) -->
  <section class="chap chap--r chap--progress" id="progress" data-chap="10" data-fx="zoom" aria-labelledby="chap-progress-title">
    <div class="chap__sticky">
      <div class="chap__bg" aria-hidden="true">
<div class="fly-bg chap-bg fly-bg--rank" data-follow>
          <p class="bg-pts"><span data-bg-pts>0</span><small>pts</small></p>
          <div class="bg-pods"><i class="p2" data-bg-pod="1"><b>2</b></i><i class="p1" data-bg-pod="0"><b>1</b></i><i class="p3" data-bg-pod="2"><b>3</b></i></div>
          {Array.from({ length: 16 }).map((_, i) => <span class="bg-spark" style={`--m:${MARKERS[i % 6]};--i:${i}`}></span>)}
        </div>
      </div>
      <div class="chap__text" data-chap-text>
        <span class="fly-step__n" style={`--m:${MARKERS[4]}`}>11</span>
        <h2 class="chap__title" id="chap-progress-title">{steps[10].t}</h2>
        <p>{steps[10].b}</p>
      </div>
      <div class="chap__phone" data-chap-phone>
        <Phone class="chap-phone" label={steps[10].t}>
          <!-- 10: rankings + progress -->
          <div class="screen is-on rk" data-fs="10">
            <p class="rk-top"><span class="app-back">Back</span><b>Rankings</b><span></span></p>
            <div class="rk-tabs"><span class="is-on" data-rk-tab="0">Leaderboard</span><span data-rk-tab="1">Progress</span><i data-rk-pill></i></div>
            <div class="rk-views" data-rk-views>
              <div class="rk-lb">
                <p class="rk-lb__t">Global rankings</p>
                <p class="rk-lb__s" data-rk-sub>Racing to your rank…</p>
                <div class="rk-pod">
                  <div class="rk-p rk-p--2"><span class="av av--you" data-rk-youav>You</span><b data-rk-youpts>★ 4,797</b><i>2</i></div>
                  <div class="rk-p rk-p--1"><span class="crown">🏆</span><span class="av">LI</span><small>liftwithleo</small><b>★ 13,020</b><i>1</i></div>
                  <div class="rk-p rk-p--3"><span class="av">CO</span><small>coreclub_kai</small><b>★ 3,340</b><i>3</i></div>
                </div>
                <p class="rk-top10"><b>Top 10</b><em>See your position</em></p>
                <ol class="rk-list" data-rk-list>
                  {leaders.slice(3, 7).map((l, i) => <li><span class="pos">{i + 4}</span><span class="av">{l.n.slice(0, 2).toUpperCase()}</span><span class="nm">{l.n}</span><b>★ {l.p.toLocaleString("en-US")}</b></li>)}
                </ol>
                <div class="rk-you" data-rk-you><span class="pos" data-rk-pos>9</span><span class="av av--you">You</span><span class="nm">You</span><b>★ <span data-rk-pts>1,640</span></b></div>
              </div>
              <div class="rk-pr">
                <div class="rk-streak"><span class="flame flame--app"></span><b data-rk-streak>12</b><em>★ 4,797 pts</em><p>Day Streak</p><small>It’s a great start! Keep up the momentum</small></div>
                <div class="rk-subtabs"><span class="is-on">Stats</span><span>Achievements</span><span>History</span></div>
                <div class="rk-stats">
                  {[["Total Imports", 693, 4], ["Workouts Completed", 76, 9], ["Total Exercises", 427, 41], ["Minutes Completed", 496, 118]].map(([l, t, m]) => (
                    <><div class="rk-stat"><b data-rk-count={t}>{Number(t).toLocaleString("en-US")}</b><small>{l}</small></div><div class="rk-stat"><b data-rk-count={m}>{m}</b><small>This Month</small></div></>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </Phone>
      </div>
    </div>
  </section>

  <!-- ============================================================ EVERYTHING ELSE -->
  <section class="feat" id="features" data-chapter="Features" aria-labelledby="feat-title">
    <div class="wrap">
      <div class="feat__head">
        <h2 class="h2" id="feat-title">Everything else in the app</h2>
        <p class="lede">The small things that make a saved reel feel like a real training plan.</p>
      </div>
      <ul class="feat__list">
        {features.map((f, i) => (
          <li class="feat-row" style={`--m:${MARKERS[i % 6]}`}>
            <span class="feat-row__mark" aria-hidden="true"></span>
            <h3 class="feat-row__title">{f.t}</h3>
            <p class="feat-row__body">{f.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================================================ PROOF -->
  <section class="proof" data-chapter="Community" aria-labelledby="proof-title">
    <div class="wrap">
      <h2 class="sr-only" id="proof-title">What people say about Fitsaver</h2>
      <dl class="proof__stats">
        <div><dt>Active users</dt><dd><span data-count="1250">1,250</span>+</dd></div>
        <div><dt>Workouts imported</dt><dd><span data-count="10000">10,000</span>+</dd></div>
        <div><dt>Countries</dt><dd><span data-count="90">90</span>+</dd></div>
      </dl>
      <div class="proof__quotes">
        {testimonials.map((t, i) => (
          <figure class="quote" style={`--m:${MARKERS[i + 1]}`}>
            <blockquote>{t.quote}</blockquote>
            <figcaption><span class="quote__av" aria-hidden="true">{t.name.split(" ").map((w) => w[0]).join("")}</span>{t.name}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ FAQ -->
  <section class="faq" id="faq" data-chapter="FAQ" aria-labelledby="faq-title">
    <div class="wrap faq__grid">
      <div>
        <h2 class="h2" id="faq-title">Questions, answered</h2>
        <p class="lede">Something else on your mind? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll reply within 48 hours.</p>
      </div>
      <div class="faq__list">
        {faqs.map((f, i) => (
          <details class="faq-item" style={`--m:${MARKERS[i % 6]}`}>
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <div class="faq-item__a"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================ BLOG -->
  {posts.length > 0 && (
    <section class="latest" data-chapter="Blog" aria-labelledby="latest-title">
      <div class="wrap latest__head">
        <h2 class="h2" id="latest-title">Workouts worth saving</h2>
        <a class="btn btn--ghost btn--sm" href="/blog">All articles</a>
      </div>
      <div class="latest__row" data-drag-scroll>
        {posts.map((p, i) => (
          <a class="post-card" href={`/blog/${p.data.slug}`}>
            <span class="post-card__img">{p.data.image && <img src={postImg(p.data.image, 800)} alt="" loading="lazy" decoding="async" width="640" height="420" />}</span>
            <span class="post-card__date"><i style={`--m:${MARKERS[i % 6]}`}></i>{formatDate(p.data.date)}</span>
            <span class="post-card__title">{p.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============================================================ FINAL CTA -->
  <section class="final" data-chapter="Get the app" aria-labelledby="final-title">
    <div class="wrap">
      <h2 class="final__title" id="final-title">Your next workout is already in your saved folder.</h2>
      <a class="final__start" href={SITE.appStore} target="_blank" rel="noopener" data-track="app_store" data-smart-store data-magnet>
        <span class="final__start-label">Start Workout</span>
        <span class="final__start-sub">Get Fitsaver free</span>
      </a>
      <div class="final__stores"><Fragment set:html={storeBadgesHtml({ campaign: "website" })} /></div>
    </div>
  </section>

  <script>
    import "../scripts/home";
  </script>
</Base>
