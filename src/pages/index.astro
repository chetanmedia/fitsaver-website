---
import Base from "../layouts/Base.astro";
import Phone from "../components/Phone.astro";
import Logo from "../components/Logo.astro";
import { getPosts } from "../lib/posts";
import { SITE, MARKERS, formatDate } from "../lib/site";
import { reels, postImg, framerImg } from "../lib/media";
import { CORE, fmtTime } from "../lib/demo";
import { storeBadgesHtml } from "../lib/store-badges.mjs";
import "../styles/home.css";

const posts = (await getPosts()).slice(0, 6);

const coreSrc = framerImg(CORE.file, 1024);
const segs = CORE.segments;
const feed = [reels[0], reels[1]]; // two reels scrolled past before the core reel
const wall = [...reels, ...reels, ...reels];

const faqs = [
  { q: "Is Fitsaver free to use?", a: "Yes. The free plan lets you import up to 5 workouts and turn them into routines. Premium gives you unlimited imports, advanced scheduling and detailed streak tracking." },
  { q: "Where can I save workouts from?", a: "Instagram, TikTok, YouTube and Facebook. Tap Share on a workout video and pick Fitsaver, or copy the link and paste it into the app. You can also paste plain workout text or build a routine by hand." },
  { q: "How does Fitsaver know which exercises are in a video?", a: "It reads the reel, including the exercise names creators put on screen, and turns each one into a step with reps and sets. Every step stays linked to the moment it appears in the video, so you can watch that exact part while you train." },
  { q: "Does Fitsaver replace a workout or coaching app?", a: "No. Fitsaver organizes the workouts you already find from creators you trust. It turns them into routines you can schedule, follow with timers and track, instead of handing you a generic program." },
  { q: "Is Fitsaver on Android?", a: "Yes. Fitsaver is on the App Store for iPhone and on Google Play for Android." },
  { q: "Are my imported workouts private?", a: "Yes. Workouts you import are private to your account and aren’t shared publicly. Fitsaver only reads publicly available content from the links you share, and never asks for your social media passwords." },
];

const testimonials = [
  { quote: "I had dozens of workout reels saved but never followed them properly. This turns them into something I can actually complete.", name: "Natasha Jackson" },
  { quote: "I tried importing a few workouts and it worked better than I expected. I’m traveling a lot and this finally gives structure to workouts I usually forget about.", name: "James Bearman" },
  { quote: "Fitsaver helps me organize all my workouts in one place. Notes, social videos, week plans, everything.", name: "Matt J" },
];

const steps = [
  { t: "Share the reel", b: "On Instagram, TikTok, YouTube or Facebook, tap Share and pick Fitsaver. You can also paste a link, paste workout text, or build a routine by hand." },
  { t: "Keep scrolling. It imports in the background.", b: "Imports run in a queue, so you can keep watching or close the app. A notification tells you the moment your workout is ready." },
  { t: "Make it yours", b: "Drag moves into a new order, rename or delete one, and add a move the creator skipped. Open any exercise to log the weight for every set, add a set, and write your own form notes." },
  { t: "Pick how you’ll train it", b: "Set-based for classic lifting: every set of one move, then the next. Round-based for circuits and HIIT: every move once, then repeat." },
  { t: "Count every rep", b: "Tap Complete as you go. Forgot the move? Watch video jumps straight to that exercise’s moment in the reel. Try the button on the phone." },
  { t: "Rest without watching the clock", b: "Rest starts on its own and tells you what’s next. Set the rest time per routine, or skip it when you’re ready." },
  { t: "Finish, score, keep the streak", b: "Every finished workout earns points, adds to your streak and lands in your history." },
  { t: "Every import lands in Uncategorized. Two taps and it’s filed.", b: "Tap Organize, select workouts, then Move to. Drop them into a catalog, or create a new one on the spot, like Core workouts or Chest day." },
  { t: "Find any workout in a second", b: "One search covers every workout and catalog you’ve imported. Type the one word you remember. Go ahead, type in the phone." },
  { t: "Put it on a day", b: "Add any workout to a day of your week, see what you completed or skipped, and hold a workout to remove it." },
  { t: "Every workout counts. Literally.", b: "Finished workouts earn points that move you up the global rankings. Your progress page tracks your streak, what you imported and completed this month, and your full history." },
];

const features = [
  { t: "Mark exercises on the video", b: "Each exercise is pinned to its spot on the clip with a colored marker. Scrub, tap, and you’re watching the right move." },
  { t: "Rest time settings", b: "Set rest between sets and between exercises once per routine. Fitsaver runs it every time." },
  { t: "Sound cues", b: "Optional sounds mark each set and rest, so your eyes can stay off the screen." },
  { t: "Notes on every routine", b: "Form notes from the video come with the import, and you can add your own." },
  { t: "Weight logs", b: "Log the weight for each set and see what you lifted last time before you load the bar." },
  { t: "Discover", b: "See workouts the community just finished, with likes and comments, and borrow the ones you like." },
];

const leaders = [
  { n: "liftwithleo", p: 13020 },
  { n: "squat.queen", p: 4797, you: true },
  { n: "coreclub_kai", p: 3340 },
  { n: "repsforjess", p: 2797 },
  { n: "benchbuddy", p: 2450 },
  { n: "mobility.mo", p: 2440 },
  { n: "ironandoats", p: 2210 },
  { n: "pull.up.pete", p: 1980 },
];

const days = [
  { d: "Mon", date: "Nov 9" },
  { d: "Tue", date: "Nov 10" },
  { d: "Wed", date: "Nov 11" },
  { d: "Thu", date: "Nov 12" },
  { d: "Fri", date: "Nov 13" },
  { d: "Sat", date: "Nov 14" },
  { d: "Sun", date: "Nov 15" },
];
const planChips = [
  { id: "core", label: "Core Build Workout", min: 12, m: MARKERS[0] },
  { id: "full", label: "20 Minutes Full Body", min: 20, m: MARKERS[1] },
  { id: "mob", label: "Full-body Mobility", min: 30, m: MARKERS[2] },
  { id: "push", label: "Upper Body + Abs", min: 25, m: MARKERS[3] },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "Organization", name: "Fitsaver", url: SITE.url, logo: `${SITE.url}/apple-touch-icon.png`, email: SITE.email, sameAs: [SITE.social.instagram, SITE.social.x, SITE.appStore] },
  { "@context": "https://schema.org", "@type": "WebSite", name: "Fitsaver", url: SITE.url },
  { "@context": "https://schema.org", "@type": "MobileApplication", name: "Fitsaver: Workout Organizer", operatingSystem: "iOS, Android", applicationCategory: "HealthApplication", description: SITE.description, url: SITE.url, installUrl: SITE.appStore, offers: { "@type": "Offer", price: "0", priceCurrency: "USD" } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];

const segImg = (s: (typeof segs)[number]) => `--pos:${s.pos};--z:${s.zoom}`;

// Uncategorized grid used in the in-phone catalogs demo.
const ctCards = [
  { src: coreSrc, style: segImg(segs[0]), name: "Core Build Workout", meta: "5 exercises · ~20 min" },
  { src: reels[0].src, style: `object-position:${reels[0].pos}`, name: "Upper Body and Abs", meta: "6 exercises · ~25 min" },
  { src: reels[5].src, style: `object-position:${reels[5].pos}`, name: "Mobility Workout", meta: "9 exercises · ~30 min" },
  { src: reels[7].src, style: `object-position:${reels[7].pos}`, name: "20 Minutes Full Body", meta: "6 exercises · ~18 min" },
];

// Demo library for the in-phone search.
const R = reels;
const findItems = [
  { name: "Morning workouts", meta: "9 workouts", tags: "catalog morning mobility", cat: true, src: R[5].src, pos: R[5].pos, src2: R[2].src, pos2: R[2].pos, src3: R[7].src, pos3: R[7].pos },
  { name: "Core workouts", meta: "2 workouts", tags: "catalog core abs", cat: true, src: coreSrc, pos: segs[0].pos, src2: R[2].src, pos2: R[2].pos, src3: R[3].src, pos3: R[3].pos },
  { name: "Back workouts", meta: "1 workout", tags: "catalog back pull", cat: true, src: R[8].src, pos: R[8].pos, src2: R[4].src, pos2: R[4].pos, src3: R[1].src, pos3: R[1].pos },
  { name: "Full body", meta: "6 workouts", tags: "catalog full body strength", cat: true, src: R[1].src, pos: R[1].pos, src2: R[7].src, pos2: R[7].pos, src3: R[0].src, pos3: R[0].pos },
  { name: "Core Build Workout", meta: "5 exercises · ~12 min", tags: "core abs oblique", src: coreSrc, pos: segs[2].pos, label: "TOTAL CORE" },
  { name: "15 Minute Abs", meta: "7 exercises · ~34 min", tags: "abs core no weights", src: R[2].src, pos: R[2].pos, label: "15 MIN ABS" },
  { name: "10-Minute Morning Mobility", meta: "5 exercises · ~21 min", tags: "morning mobility stretch", src: R[5].src, pos: R[5].pos, label: "MORNING" },
  { name: "5 Minute Morning Mobility", meta: "5 exercises · ~13 min", tags: "morning mobility quick", src: R[7].src, pos: R[7].pos },
  { name: "Upper Body and Abs", meta: "6 exercises · ~25 min", tags: "upper body abs arms shoulders", src: R[0].src, pos: R[0].pos },
  { name: "20 Minutes Full Body at Home", meta: "6 exercises · ~18 min", tags: "full body home", src: R[1].src, pos: R[1].pos, label: "20 MINS" },
  { name: "Full-body Mobility Routine", meta: "8 exercises · ~30 min", tags: "full body mobility stretch", src: R[6].src, pos: R[6].pos },
  { name: "Chest Day", meta: "5 exercises · ~40 min", tags: "chest push bench", src: R[4].src, pos: R[4].pos },
];
---
<Base title={SITE.title} description={SITE.description} path="/" jsonLd={jsonLd}>
  <script is:inline>document.body.dataset.duration = "120";</script>

  <!-- ============================================================ HERO -->
  <section class="hero" data-chapter="Intro" aria-labelledby="hero-title">
    <div class="hero__feed" aria-hidden="true">
      {[0, 1].map((col) => (
        <div class={`feed-col feed-col--${col}`}>
          {[...reels, ...reels].map((r, i) => (
            <figure class="feed-card" style={`--pos:${r.pos}`}>
              <img src={r.src} alt="" loading={i < 4 ? "eager" : "lazy"} decoding="async" width="360" height="640" />
              <figcaption>{r.caption}</figcaption>
              <span class="feed-card__save"></span>
            </figure>
          ))}
        </div>
      ))}
    </div>

    <div class="wrap hero__inner">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__l1" data-split>You saved it.</span>
        <span class="hero__l2" data-split>Now train it.</span>
      </h1>
      <div class="hero__body">
        <p class="hero__lede">
          Share any workout reel to Fitsaver. It finds every exercise the creator shows, breaks it into steps with reps,
          sets and rest timers, and keeps each step linked to its moment in the video.
        </p>
        <Fragment set:html={storeBadgesHtml({ campaign: "website" })} />
        <p class="hero__proof"><b>1,250+</b> people train with Fitsaver in <b>90+</b> countries</p>
      </div>

      <div class="hero__stage">
        <div class="hero__glow" aria-hidden="true"></div>
        <Phone class="hero-phone" label="Sharing an Instagram workout reel to Fitsaver, which turns it into a five-step routine" data-hero-phone>
          <!-- Feed of reels -->
          <div class="screen hs-feed is-on" data-hs="feed">
            <div class="hs-stack" data-hs-stack>
              {feed.map((r) => (
                <div class="hs-reel">
                  <img src={r.src} alt="" style={`object-position:${r.pos}`} width="360" height="640" />
                  <div class="hs-reel__shade"></div>
                  <p class="hs-reel__cap hs-reel__cap--cover">{r.caption}</p>
                  <div class="hs-reel__meta"><b>{r.handle.replace("@", "")}</b><span>save this for later</span></div>
                </div>
              ))}
              <div class="hs-reel hs-reel--core">
                <div class="hs-reel__media"><img src={coreSrc} alt="" data-hs-core style={segImg(segs[0])} width="360" height="640" /></div>
                <div class="hs-reel__shade"></div>
                <p class="hs-reel__cap hs-reel__cap--cover" data-hs-cover>{CORE.cover}</p>
                <p class="hs-reel__cap" data-hs-cap></p>
                <div class="hs-reel__meta"><b>{CORE.handle}</b><span>your future abs will thank you</span></div>
                <div class="hs-reel__bar"><i data-hs-progress></i></div>
              </div>
            </div>
            <div class="hs-chrome"><span class="ic ic-back"></span><span class="ic ic-search"></span></div>
            <div class="hs-rail">
              <span><i class="ic ic-heart"></i>63.2K</span>
              <span><i class="ic ic-chat"></i>329</span>
              <span><i class="ic ic-loop"></i>1,195</span>
              <span data-hs-share><i class="ic ic-send"></i>16.4K</span>
            </div>
          </div>

          <!-- Instagram "Send to" sheet -->
          <div class="hs-ig" data-hs="ig">
            <div class="sheet-grab"></div>
            <div class="hs-ig__search"><i class="ic ic-search"></i>Search</div>
            <div class="hs-ig__people">
              {[["MA", "Maya", "#ff8e3c"], ["JO", "Jordan", "#5b8cff"], ["PR", "Priya", "#ff6bae"], ["SA", "Sam", "#4fe3d1"], ["AL", "Alex", "#a98bff"], ["NO", "Noor", "#e2ff2e"]].map(([i, n, c]) => (
                <span class="person"><b style={`--c:${c}`}>{i}</b><small>{n}</small></span>
              ))}
            </div>
            <div class="hs-ig__actions">
              <span><i class="ic ic-story"></i><small>Add to story</small></span>
              <span><i class="ic ic-link"></i><small>Copy link</small></span>
              <span class="g"><i class="ic ic-bubble"></i><small>Messages</small></span>
              <span class="g"><i class="ic ic-phone"></i><small>WhatsApp</small></span>
              <span data-hs-shareto><i class="ic ic-share"></i><small>Share to…</small></span>
            </div>
          </div>

          <!-- iOS share sheet -->
          <div class="hs-ios" data-hs="ios">
            <div class="sheet-grab"></div>
            <div class="hs-ios__head">
              <span class="hs-ios__safari"><i class="ic ic-compass"></i></span>
              <div><b>Reel from {CORE.handle}</b><small>instagram.com</small></div>
            </div>
            <div class="hs-ios__people">
              {[["MB", "MacBook Pro", "#7a7a80"], ["MA", "Maya", "#ff8e3c"], ["JO", "Jordan", "#5b8cff"], ["PR", "Priya", "#ff6bae"]].map(([i, n, c]) => (
                <span class="person"><b style={`--c:${c}`}>{i}</b><small>{n}</small></span>
              ))}
            </div>
            <div class="hs-ios__apps">
              <span class="tile" style="--c:#2f7bff"><i class="ic ic-airdrop"></i><small>AirDrop</small></span>
              <span class="tile" style="--c:#34c759"><i class="ic ic-bubble"></i><small>Messages</small></span>
              <span class="tile" style="--c:#2f7bff"><i class="ic ic-mail"></i><small>Mail</small></span>
              <span class="tile tile--fs" data-hs-fs><b><Logo size={30} /></b><small>FitSaver</small></span>
            </div>
            <div class="hs-ios__acts">
              <span><i class="ic ic-copy"></i><small>Copy</small></span>
              <span><i class="ic ic-note"></i><small>Quick Note</small></span>
              <span><i class="ic ic-compass"></i><small>Open in Chrome</small></span>
              <span><i class="ic ic-chev"></i><small>View More</small></span>
            </div>
          </div>

          <!-- App opening -->
          <div class="hs-splash" data-hs="splash"><span class="hs-splash__logo"><Logo size={64} /></span></div>
          <div class="screen hs-launch" data-hs="launch"><span class="hs-launch__word"><span class="mini-mark"><Logo size={14} /></span>FitSaver</span><span class="dots"><i></i><i></i><i></i></span></div>

          <!-- Import queue -->
          <div class="screen q" data-hs="queue">
            <p class="app-back">Back</p>
            <p class="q__title">Import queue</p>
            <p class="q__sub">You can view the status of importing workouts here</p>
            <div class="q-card">
              <div class="q-card__row">
                <span class="q-card__thumb" data-q-thumb><i class="ic ic-camera"></i><img src={coreSrc} alt="" style={segImg(segs[0])} /></span>
                <span class="q-card__txt">
                  <em>Currently processing</em>
                  <b data-q-name>Instagram · reel/C9xF2kq</b>
                  <small>instagram.com/reel/C9xF2kq</small>
                  <small data-q-status>Getting details</small>
                </span>
                <span class="q-card__pct" data-q-pct>5%</span>
              </div>
              <div class="q-card__bar"><i data-q-bar></i></div>
              <p class="q-card__note">You can use the app normally or close the app. We’ll notify you once the workout is ready.</p>
            </div>
            <p class="q__recent">Recent imported workouts</p>
            <div class="q-done"><img src={reels[0].src} alt="" style={`object-position:${reels[0].pos}`} /><span><b>Upper Body and Abs Workout</b><small>Completed Nov 12 at 10:28 AM</small></span><i class="ok"></i></div>
            <div class="q-done"><img src={reels[5].src} alt="" style={`object-position:${reels[5].pos}`} /><span><b>Mobility Workout</b><small>Completed Nov 12 at 7:54 AM</small></span><i class="ok"></i></div>
          </div>

          <!-- Push notification -->
          <div class="notif" data-hs="notif">
            <span class="notif__icon"><Logo size={18} /></span>
            <span class="notif__txt"><b>Workout Ready!</b><small>{CORE.title} has been processed and is ready to view.</small></span>
            <span class="notif__time">now</span>
          </div>

          <!-- Routine -->
          <div class="screen rt" data-hs="routine">
            <p class="app-back">Back</p>
            <p class="rt__title">{CORE.title}</p>
            <p class="rt__src">From Instagram <b>View Original</b></p>
            <div class="rt__video"><img src={coreSrc} alt="" style={segImg(segs[0])} /><i class="play"></i></div>
            <div class="rt__head"><b>Exercises ({segs.length})</b><span>~{CORE.minutes} min</span><em>Rest Time Settings</em></div>
            <ol class="rt-list">
              {segs.map((s, i) => (
                <li data-hs-row>
                  <span class="n">{i + 1}</span>
                  <span class="th"><img src={coreSrc} alt="" style={segImg(s)} /><i class="play"></i></span>
                  <span class="t">{s.name}<small>3 sets</small></span>
                  <i class="trash"></i>
                </li>
              ))}
            </ol>
            <div class="app-cta-btn">Start Workout</div>
          </div>

          <span class="finger" data-finger aria-hidden="true"></span>
          <div class="hs-fade" data-hs-fade></div>
        </Phone>

        <div class="hero-chip hero-chip--a" data-chip="a" aria-hidden="true"><span class="dot" style="--m:var(--m2)"></span>Instagram reel, 0:20</div>
        <div class="hero-chip hero-chip--b" data-chip="b" aria-hidden="true"><span class="spin"></span>Importing in the background</div>
        <div class="hero-chip hero-chip--c" data-chip="c" aria-hidden="true"><span class="dots">{MARKERS.slice(0, 5).map((m) => <i style={`--m:${m}`}></i>)}</span>5 exercises, each linked to its clip</div>
      </div>
    </div>
    <a class="hero__cue" href="#saved" aria-label="Scroll to the next section"><span></span></a>
  </section>

  <!-- ============================================================ PROBLEM: THE SAVED FOLDER -->
  <section class="saved" id="saved" data-chapter="The saved folder" aria-labelledby="saved-title">
    <div class="saved__wall" aria-hidden="true">
      {[0, 1, 2].map((row) => (
        <div class={`saved__row saved__row--${row}`} data-wall-row={row}>
          {[...wall.slice(row * 3), ...wall.slice(0, row * 3)].map((r) => (
            <figure class="saved-tile" style={`--pos:${r.pos}`}>
              <img src={r.src} alt="" loading="lazy" decoding="async" width="200" height="356" />
              <figcaption>{r.caption}</figcaption>
              <i class="saved-tile__flag"></i>
            </figure>
          ))}
        </div>
      ))}
    </div>
    <div class="wrap saved__copy">
      <h2 class="saved__title" id="saved-title">
        <span class="saved__a">You saved 214 workouts.</span>
        <span class="saved__b">You’ve done 3 of them.</span>
      </h2>
      <p class="lede saved__lede">A reel is great for finding a workout and terrible for doing one. The sets are buried in a caption, the moves flash by in two seconds, and the folder becomes a pile you never open again.</p>
    </div>
    <ul class="saved__thoughts" aria-label="Common problems with saved workout reels">
      <li style="--m:var(--m3)" data-thought>Which one was the glute one?</li>
      <li style="--m:var(--m2)" data-thought>How many sets was that?</li>
      <li style="--m:var(--m5)" data-thought>Screenshot. Screenshot. Screenshot.</li>
      <li style="--m:var(--m4)" data-thought>Pause, rewind, squint at the caption</li>
    </ul>
  </section>

  <!-- ============================================================ THE BREAKDOWN -->
  <section class="bd" id="breakdown" data-chapter="The breakdown" aria-labelledby="bd-title">
    <div class="bd__sticky">
      <div class="wrap bd__head">
        <h2 class="h2" id="bd-title">It watches the reel, so you don’t have to.</h2>
        <p class="lede">Fitsaver reads the exercises the creator puts on screen, turns each one into a step, and remembers the exact second it appears.</p>
      </div>
      <div class="wrap bd__stage" data-bd-stage>
        <div class="bd__left">
          <div class="bd-reel" data-bd-reel>
            <img class="bd-reel__img" src={coreSrc} alt="" data-bd-img style={segImg(segs[0])} width="720" height="1280" />
            <div class="bd-reel__shade"></div>
            <p class="bd-reel__cover" data-bd-cover>{CORE.cover}</p>
            <p class="bd-reel__cap" data-bd-cap><span data-bd-captext>{segs[0].cap}</span><i class="bd-scan" data-bd-scan><b></b><b></b><b></b><b></b></i></p>
            <div class="bd-reel__meta"><b>{CORE.handle}</b><span>10 min total core</span></div>
            <span class="bd-reel__badge" data-bd-badge>Reading the reel</span>
          </div>
          <div class="bd-scrub" aria-hidden="true">
            <div class="bd-scrub__marks">
              {segs.map((s, i) => <i data-bd-mark={i} style={`left:${(s.start / CORE.length) * 100 + 2}%;--m:${MARKERS[i]}`}></i>)}
            </div>
            <div class="bd-scrub__track"><i data-bd-fill></i><b data-bd-thumb></b></div>
            <p class="bd-scrub__label"><span data-bd-label>Full video</span><span><span data-bd-time>0:00</span> / {fmtTime(CORE.length)}</span></p>
          </div>
        </div>
        <div class="bd__right">
          <div class="bd-card">
            <p class="bd-card__title">{CORE.title}</p>
            <p class="bd-card__src">From Instagram <b>View Original</b></p>
            <p class="bd-card__head"><b>Exercises (<span data-bd-count>0</span>)</b><span>~{CORE.minutes} min</span></p>
            <ol class="bd-list">
              {segs.map((s, i) => (
                <li class="bd-row" data-bd-row={i} style={`--m:${MARKERS[i]}`}>
                  <button type="button" data-bd-btn={i} aria-label={`Watch ${s.name} at ${fmtTime(s.start)}`}>
                    <span class="n">{i + 1}</span>
                    <span class="th"><img src={coreSrc} alt="" style={segImg(s)} loading="lazy" /><i class="play"></i></span>
                    <span class="t">{s.name}<small>{s.reps} reps · 3 sets</small></span>
                    <span class="ts">{fmtTime(s.start)}</span>
                  </button>
                </li>
              ))}
            </ol>
            <p class="bd-hint" data-bd-hint>Tap any exercise to watch its exact moment</p>
          </div>
        </div>
