---
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";
import "../styles/blog.css";
---
<Base title={SITE.title} description="Questions about Fitsaver? Send us a message and we’ll get back to you within 48 hours." path="/contact" scrubber={false}>
  <section class="wrap page contact">
    <div class="contact__grid">
      <div>
        <h1 class="page__title">Do you have further questions?</h1>
        <p class="lede">Reach out and we’ll get back to you within 48 hours.</p>
        <ul class="contact__ways">
          <li><span>Email</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><span>Instagram</span><a href={SITE.social.instagram} target="_blank" rel="noopener">@fitsaver.app</a></li>
          <li><span>Account</span><a href="/delete-account">Delete your account</a></li>
        </ul>
      </div>
      <!-- Netlify Forms: submissions appear in Netlify under Forms > contact. -->
      <form class="contact__form" name="contact" method="POST" action="/contact-sent" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="contact" />
        <p class="sr-only"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <label><span>Name</span><input name="name" autocomplete="name" required /></label>
        <label><span>Email</span><input name="email" type="email" autocomplete="email" required /></label>
        <label><span>Message</span><textarea name="message" rows="6" required></textarea></label>
        <button class="btn" type="submit">Send message</button>
      </form>
    </div>
  </section>
</Base>

<style>
  .contact__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .contact__ways { list-style: none; padding: 0; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .contact__ways li { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); }
  .contact__ways span { color: var(--smoke); }
  .contact__ways a { color: var(--chalk); text-decoration: none; font-weight: 600; }
  .contact__ways a:hover { color: var(--lime); }
  .contact__form { display: grid; gap: 1rem; padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: var(--radius-l); background: var(--card); }
  .contact__form label { display: grid; gap: 0.45rem; font-weight: 600; font-size: 0.95rem; }
  .contact__form input, .contact__form textarea {
    width: 100%; padding: 0.85rem 1rem; border: 0; border-radius: 14px;
    background: #000; color: var(--chalk); font: inherit; font-weight: 400;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }
  .contact__form input:focus, .contact__form textarea:focus { outline: none; box-shadow: inset 0 0 0 1.5px var(--lime); }
  .contact__form .btn { justify-self: start; margin-top: 0.5rem; }
  @media (max-width: 860px) { .contact__grid { grid-template-columns: 1fr; } }
</style>
