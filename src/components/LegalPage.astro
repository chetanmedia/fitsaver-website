---
import Base from "../layouts/Base.astro";
import "../styles/blog.css";
interface Props { title: string; heading: string; description?: string; path?: string }
const { title, heading, description, path } = Astro.props;
---
<Base title={title} description={description} path={path} scrubber={false}>
  <section class="wrap page">
    <h1 class="page__title">{heading}</h1>
    <div class="prose">
      <slot />
    </div>
  </section>
</Base>
