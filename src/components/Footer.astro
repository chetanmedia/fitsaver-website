---
import Logo from "./Logo.astro";
import { SITE } from "../lib/site";
import { storeBadgesHtml } from "../lib/store-badges.mjs";
const year = new Date().getFullYear();
const word = "Fitsaver".split("");
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href="/" aria-label="Fitsaver home">
          <span class="logo__mark"><Logo size={24} /></span>
          <span class="logo__word">Fitsaver</span>
        </a>
        <p class="footer-tag">Turn the workouts you save into routines you actually finish.</p>
        <Fragment set:html={storeBadgesHtml({ campaign: "website", size: "sm" })} />
      </div>
      <div>
        <h2>App</h2>
        <ul>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#faq">FAQ</a></li>
          <li><a href={SITE.appStore} target="_blank" rel="noopener" data-track="app_store">iPhone</a></li>
          <li><a href={SITE.playStore("website")} target="_blank" rel="noopener" data-track="google_play">Android</a></li>
        </ul>
      </div>
      <div>
        <h2>Read</h2>
        <ul>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/blog/workout-split-guide-how-to-pick-the-right-3-4-5-or-6-day-split">Workout splits</a></li>
          <li><a href="/blog/best-ab-workout-exercises-ranked">Ab workouts</a></li>
          <li><a href="/blog/how-to-save-instagram-reels-and-actually-use-the-workout-ones">Saving reels</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privay-policy">Privacy policy</a></li>
          <li><a href="/delete-account">Delete account</a></li>
          <li><a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={SITE.social.x} target="_blank" rel="noopener">X</a></li>
        </ul>
      </div>
    </div>
    <p class="wordmark" aria-hidden="true" data-wordmark>{word.map((c) => <span>{c}</span>)}</p>
    <div class="footer-legal">
      <span>© {year} Fitsaver. All rights reserved.</span>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</footer>
