---
import Logo from "./Logo.astro";
import { SITE } from "../lib/site";
const path = Astro.url.pathname;
const links = [
  { href: "/#how-it-works", label: "How it works" },
  { href: "/#features", label: "Features" },
  { href: "/tools", label: "Free tools" },
  { href: "/blog", label: "Blog" },
  { href: "/#faq", label: "FAQ" },
];
---
<header class="site-header" data-header>
  <div class="site-header__glass" aria-hidden="true"></div>
  <div class="wrap site-header__bar">
    <a class="logo" href="/" aria-label="Fitsaver home">
      <span class="logo__mark"><Logo size={24} /></span>
      <span class="logo__word">Fitsaver</span>
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
      <span></span><span></span><span></span><span class="sr-only">Menu</span>
    </button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={(l.href === "/blog" || l.href === "/tools") && path.startsWith(l.href) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn--sm" href={SITE.appStore} target="_blank" rel="noopener" data-track="app_store" data-smart-store>Get the app</a>
  </div>
</header>
